# Frontend build variable (include the backend /api prefix)
VITE_API_URL=https://your-backend-domain.example/api

# Backend public URLs
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example
GOOGLE_RETURNURL=https://your-frontend-domain.example
# PayOS service appends /payment-success and /payment-cancel itself.
PAYOS_RETURNURL=https://your-frontend-domain.example
PAYOS_CANCELURL=https://your-frontend-domain.example

# SQL Server
DB_HOST=your-sql-server-host
DB_PORT=5432
DB_NAME=railway
DB_USER=postgres
DB_PASSWORD=replace_me
DB_SSLMODE=disable

# Redis
REDIS_HOST=your-redis-host
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=replace_me

# Authentication and integrations
JWT_SECRET=replace_with_a_long_random_secret
GOOGLE_CLIENT_ID=replace_me
GOOGLE_CLIENT_SECRET=replace_me
PAYOS_CLIENT_ID=replace_me
PAYOS_API_KEY=replace_me
PAYOS_CHECKSUM_KEY=replace_me
MAIL_SYSTEM=your-email@example.com
MAIL_PASSWORD=replace_me
BREVO_API_KEY=replace_me
GEMINI_API_KEY=replace_me
CLOUDINARY_NAME=replace_me
CLOUDINARY_API_KEY=replace_me
CLOUDINARY_API_SECRET=replace_me
